# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in ONE provider.
# The project runs with any of the four. Groq and Google have
# generous free tiers; Ollama needs no key at all.
# ─────────────────────────────────────────────────────────────

# Which provider to use: openai | groq | google | ollama
LLM_PROVIDER=groq

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Groq (free, fast) ---
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# --- Google Gemini (free tier) ---
GOOGLE_API_KEY=
GOOGLE_CHAT_MODEL=gemini-1.5-flash
GOOGLE_EMBED_MODEL=models/text-embedding-004

# --- Ollama (fully local, no API key) ---
# Install from https://ollama.com then: `ollama pull llama3.1` and `ollama pull nomic-embed-text`
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# Groq/Ollama have no embedding model of their own here, so embeddings fall back to
# a local HuggingFace/sentence-transformers model when EMBED_PROVIDER=local.
# Options: openai | google | ollama | local
EMBED_PROVIDER=local
