# ─────────────────────────────────────────────────────────────
# RetailIQ configuration
#
# Copy to `.env` and fill in ONE provider. Groq and Google have
# generous free tiers; Ollama needs no key at all.
#
# Every value below is OPTIONAL — what is shown is the default
# the application uses when the variable is unset.
#
# `.env` is git-ignored. Never commit real keys.
# ─────────────────────────────────────────────────────────────

# --- Application ---------------------------------------------
APP_ENV=local                  # local | staging | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console             # console | json   (use json in production)

# --- Provider selection --------------------------------------
LLM_PROVIDER=huggingface       # huggingface | groq | google | openai | ollama
EMBED_PROVIDER=huggingface     # huggingface | google | openai | ollama | local
LLM_TEMPERATURE=0.0
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=2

# --- Hugging Face (recommended: ONE free token covers chat + embeddings) ---
# Token: https://huggingface.co/settings/tokens  (a read token is enough)
# Either variable name works; HF_TOKEN is the shorter convention.
HF_TOKEN=
HF_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Groq (free tier, fastest inference) ---
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# --- Google Gemini (free tier) ---
GOOGLE_API_KEY=
GOOGLE_CHAT_MODEL=gemini-1.5-flash
GOOGLE_EMBED_MODEL=models/text-embedding-004

# --- Ollama (fully local, no API key) ---
# Install from https://ollama.com then:
#   ollama pull llama3.1 && ollama pull nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# --- Local on-device embeddings (no key; pairs with any chat provider) ---
LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Retrieval -----------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVE_K=4
COLLECTION_NAME=retail_kb
# CHROMA_DIR=/abs/path/to/store    # defaults to <project>/var/chroma

# --- Agent control loop --------------------------------------
MAX_QUERY_REWRITES=2
MAX_GENERATION_RETRIES=2
RECURSION_LIMIT=25

# --- Tools ---------------------------------------------------
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_RESULTS=4

# duckduckgo (no key, default) | tavily (needs a key, cleaner extracts)
# Tavily returns LLM-ready content rather than SERP snippets, which matters
# because the result is pasted straight into the generation context.
# Free tier: 1,000 searches/month at https://app.tavily.com
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# --- API server ----------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=*

# --- Observability: LangSmith tracing -------------------------
# Optional and off by default. When enabled, every agent run is traced as a
# nested tree (router → grader per chunk → generate → hallucination check),
# which is the only practical way to answer "which of the 7 LLM calls went
# wrong?" in production. Get a key at https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=retailiq
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
